#!/usr/bin/env ruby
# frozen_string_literal: true
# ag-store — the backlog store dispatcher. Every skill that touches the Inbox
# or a spec goes through here instead of reading/writing files (or an
# Airtable base, etc.) itself; which backend answers is decided by --store,
# so the skill's own instructions stay adapter-agnostic.
#
# Usage: ag-store <op> --dir <agentile-dir> [--store local|airtable] [args...]
#   --dir   the resolved Agentile directory (default docs/agentile/), i.e.
#           the value skills already read from .agentile/config.md.
#   --store which adapter answers this call (default: local — today's file
#           behaviour, unchanged). A project's actual choice lives in
#           .agentile/store.md; the SKILL reads that and passes it here.
#
# Ops (see bin/ag-store-adapters/local.rb for the local adapter's exact
# semantics — this dispatcher does no business logic of its own):
#   inbox_list                                        --dir <dir>
#   inbox_add    <text> [--title "<label>"] [--type feature|bug|chore|spike]  --dir <dir>
#   inbox_drop   <id>                                 --dir <dir>
#   spec_list    [--status s] [--pool active|done|abandoned] --dir <dir>
#   spec_read    <id>                                 --dir <dir>
#   spec_create  <slug>            (markdown on stdin) --dir <dir>
#   spec_write   <id> --set k=v [--set k=v ...]         --dir <dir>
#   rank         <slug> [<slug>...]                    --dir <dir>
#   claim        <identity> [label] [wip]              --dir <dir>
#   release      <id>                                  --dir <dir>
#   ship         <id>                                  --dir <dir>
#   abandon      <id> --reason "<text>"                --dir <dir>
#   promote      <id>            (flat spec -> directory form) --dir <dir>
#   deps         <id>                                  --dir <dir>
#   dependents   <slug>                                --dir <dir>
#   attach       <id> <plan-path>                      --dir <dir>
#   whoami
#   doctor                                              --dir <dir>
#
# airtable-only:
#   create_base  <name> --airtable-workspace <id>       (no --airtable-base yet — creates one)
#   provision                                           --dir <dir> --store airtable --airtable-base <id>
#
# --store airtable also needs --airtable-base <id> (except create_base, which
# makes one) and, on ENV, AGENTILE_AIRTABLE_TOKEN. Table names default to
# Inbox/Specs/Members; override with --airtable-inbox-table / --airtable-specs-table
# / --airtable-members-table if a project renamed them.
#
# All output is one JSON value on stdout (a string, array, object, or bool) —
# a skill reads it with a JSON parser, never by scraping stdout text. Errors
# go to stderr with a non-zero exit, same convention as bin/ag-claim.

require "json"

require_relative "ag-store-adapters/local"
require_relative "ag-store-adapters/airtable"

def parse_flags(argv)
  positional = []
  flags = {}
  i = 0
  while i < argv.length
    arg = argv[i]
    if arg.start_with?("--")
      key = arg[2..]
      # A boolean-style flag has no following value (either end-of-args or the
      # next token is itself a --flag); otherwise consume the next token as its value.
      if i + 1 < argv.length && !argv[i + 1].start_with?("--")
        flags[key] = argv[i + 1]
        i += 2
      else
        flags[key] = true
        i += 1
      end
    else
      positional << arg
      i += 1
    end
  end
  [positional, flags]
end

# --set key=value may repeat (spec_write); pull every occurrence out before
# the generic single-value flag parser runs.
def extract_sets(argv)
  sets = {}
  rest = []
  i = 0
  while i < argv.length
    if argv[i] == "--set" && argv[i + 1]
      k, v = argv[i + 1].split("=", 2)
      sets[k] = v
      i += 2
    else
      rest << argv[i]
      i += 1
    end
  end
  [rest, sets]
end

op = ARGV[0]
abort "usage: ag-store <op> --dir <agentile-dir> [--store local|airtable] [args...]" if op.nil?

rest, sets = extract_sets(ARGV[1..])
positional, flags = parse_flags(rest)
store = flags["store"] || "local"
agentile_dir = flags["dir"]
specs_dir = agentile_dir && File.join(agentile_dir, "specs")

# create_base has no base yet, so it can't go through an Adapter instance
# (every other airtable op needs an existing --airtable-base).
if op == "create_base"
  base_id = Airtable.create_base(
    token: ENV.fetch("AGENTILE_AIRTABLE_TOKEN", nil), workspace_id: flags["airtable-workspace"],
    name: positional[0], inbox_table: flags["airtable-inbox-table"] || "Inbox",
    specs_table: flags["airtable-specs-table"] || "Specs", members_table: flags["airtable-members-table"] || "Members"
  )
  puts JSON.generate(base_id)
  exit 0
end

adapter = if store == "airtable"
            Airtable::Adapter.new(
              base_id: flags["airtable-base"], inbox_table: flags["airtable-inbox-table"] || "Inbox",
              specs_table: flags["airtable-specs-table"] || "Specs", members_table: flags["airtable-members-table"] || "Members"
            )
          elsif store != "local"
            abort "ag-store: unknown adapter '#{store}'"
          end

result =
  if store == "airtable"
    case op
    when "inbox_list" then adapter.inbox_list
    when "inbox_add" then adapter.inbox_add(positional[0], flags["by"], flags["title"], flags["type"])
    when "inbox_drop" then adapter.inbox_drop(positional[0])
    when "spec_list" then adapter.spec_list(status: flags["status"], pool: flags["pool"] || "active")
    when "spec_read" then adapter.spec_read(positional[0])
    when "spec_create" then adapter.spec_create(positional[0], $stdin.read)
    when "spec_write" then adapter.spec_write(positional[0], sets.transform_keys(&:to_sym))
    when "rank" then adapter.rank(positional)
    when "claim" then adapter.claim(positional[0], positional[1], positional[2])
    when "release" then adapter.release(positional[0])
    when "ship" then adapter.ship(positional[0])
    when "abandon" then adapter.abandon(positional[0], reason: flags["reason"].to_s)
    when "deps" then adapter.deps(positional[0])
    when "dependents" then adapter.dependents(positional[0])
    when "promote" then adapter.promote(positional[0], agentile_dir)
    when "attach" then adapter.attach(positional[0], positional[1])
    when "whoami" then adapter.whoami
    when "doctor" then adapter.doctor
    when "provision" then adapter.provision
    else abort "ag-store: unknown op '#{op}'"
    end
  else
  case op
  when "inbox_list"
    Local.inbox_list(agentile_dir).map { |s| s.reject { |k, _| k == :line_index } }
  when "inbox_add"
    Local.inbox_add(agentile_dir, positional[0], flags["by"], flags["title"], flags["type"])
  when "inbox_drop"
    Local.inbox_drop(agentile_dir, positional[0])
  when "spec_list"
    Local.spec_list(specs_dir, status: flags["status"], pool: flags["pool"] || "active")
  when "spec_read"
    Local.spec_read(specs_dir, positional[0])
  when "spec_write"
    Local.spec_write(specs_dir, positional[0], sets)
  when "spec_create"
    markdown = $stdin.read
    Local.spec_create(specs_dir, positional[0], markdown)
  when "rank"
    Local.rank(specs_dir, positional)
  when "claim"
    Local.claim(specs_dir, positional[0], positional[1], positional[2])
  when "release"
    Local.release(specs_dir, positional[0])
  when "ship"
    Local.ship(specs_dir, positional[0])
  when "abandon"
    Local.abandon(specs_dir, positional[0], reason: flags["reason"].to_s)
  when "promote"
    Local.promote(specs_dir, positional[0])
  when "deps"
    Local.deps(specs_dir, positional[0])
  when "dependents"
    Local.dependents(specs_dir, positional[0])
  when "attach"
    Local.attach(specs_dir, positional[0], positional[1])
  when "whoami"
    Local.whoami
  when "doctor"
    Local.doctor(agentile_dir)
  else
    abort "ag-store: unknown op '#{op}'"
  end
  end

puts JSON.generate(result)
