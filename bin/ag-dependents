#!/usr/bin/env ruby
# frozen_string_literal: true
# Thin wrapper — the dependents logic lives in bin/ag-store-adapters/local.rb
# (the `local` store adapter), shared with bin/ag-store. Kept as its own
# script, with this exact CLI shape, for backward compatibility and for
# dev/test-ag-dependents.rb, which exercises it directly.
#
# Print the transitive set of ACTIVE specs whose depends_on reaches <slug>.
# Usage: ag-dependents <specs-dir> <slug>
# Output: one dependent slug per line, nearest-first (BFS order); empty if none.
require_relative "ag-store-adapters/local"

specs_dir, target = ARGV
abort "usage: ag-dependents <specs-dir> <slug>" if specs_dir.nil? || target.to_s.empty?

out = Local.dependents(specs_dir, target)
puts out.join("\n") unless out.empty?
