{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"${CLAUDE_PLUGIN_ROOT}/hooks/format-on-edit.rb\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
